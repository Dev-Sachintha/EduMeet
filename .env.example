# ---------- Backend ----------
# SQLite (default, no install needed) - creates edumeet.db in the project folder
DATABASE_URL=sqlite:///edumeet.db
# PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg2://edumeet:change_me@localhost:5432/edumeet
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# The first administrator is created automatically if no admin exists yet
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=EduMeet Admin

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---------- Sign-in rules ----------
# true  = an account can be signed in on only ONE computer at a time
SINGLE_SESSION_PER_ACCOUNT=true
# true  = a computer can have only ONE account signed in at a time (set false to test with 2 windows on 1 PC)
ONE_ACCOUNT_PER_DEVICE=true
# A sign-in counts as "live" while the app is open (it checks in every 30 s). After the app is closed the
# account is free again after this many seconds.
SESSION_IDLE_SECONDS=120
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=5

# ---------- E-mail rules (fake / temporary / duplicate addresses) ----------
# New accounts must type a code that was e-mailed to them (proves the address is real).
REQUIRE_EMAIL_VERIFICATION=true
# Strongest rule for a school or company: only these domains may register (comma separated)
ALLOWED_EMAIL_DOMAINS=
# Extra domains to refuse, on top of the built-in disposable list (backend/data/disposable_domains.txt)
BLOCKED_EMAIL_DOMAINS=
CHECK_EMAIL_DNS=true
STRIP_PLUS_ALIASES=true
# One person = one account (best effort): limits for self-registration. 0 = unlimited.
MAX_ACCOUNTS_PER_DEVICE=1
MAX_REGISTRATIONS_PER_IP_PER_DAY=5

# ---------- Outgoing e-mail (SMTP). Empty SMTP_HOST = codes are printed in the server window ----------
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chamikara24sachintha@gmail.com
SMTP_PASSWORD=btxg gxty ehgt iekd
SMTP_FROM=chamikara24sachintha@gmail.com

# ---------- AI features ----------
# Summaries, action items, the AI assistant, quizzes and lesson notes use the Claude API (needs a key from
# console.anthropic.com). Leave empty to switch those off. The transcript text is sent to Anthropic.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-5-5
# Live captions use Whisper on THIS computer (free). tiny = fastest, base = better, small = best but slow on CPU.
WHISPER_MODEL=base
# Empty = auto-detect the language. Or set e.g. en, si, ta
WHISPER_LANGUAGE=
AI_MAX_PARALLEL_TRANSCRIPTIONS=2
AI_CALLS_PER_10_MIN=20
MAX_RECORDING_MB=1024
CORS_ORIGINS=*


# ---------- Attendance ----------
ATTENDANCE_GRACE_MINUTES=10
ATTENDANCE_MIN_PERCENT=50
MAX_RECORDING_MB=1024
CORS_ORIGINS=*

# Used by `python main.py server`. Use 0.0.0.0 to accept LAN connections.
HOST=127.0.0.1
PORT=8000

# ---------- WebRTC ICE servers ----------
STUN_URLS=stun:stun.l.google.com:19302
# TURN is REQUIRED for reliable calls across the internet / strict firewalls (see README)
TURN_URL=turn:in.relay.metered.ca:80,turn:in.relay.metered.ca:80?transport=tcp,turn:in.relay.metered.ca:443,turns:in.relay.metered.ca:443?transport=tcp
TURN_USERNAME=697883980e6ab48359137e6b
TURN_CREDENTIAL=BaJnpVMzdxVuee+G

# ---------- Desktop client ----------
EDUMEET_SERVER_URL=http://127.0.0.1:8000